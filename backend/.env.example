# ── Database ──────────────────────────────────────────────────────────────
# Hosted PostGIS / PostgreSQL connection string (Neon, Supabase, Render,
# Railway, ...). Accepted schemes: "postgresql+asyncpg://" (preferred),
# "postgresql://" and "postgres://" - the latter two are auto-converted to
# "postgresql+asyncpg://" for you.
DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# Local Docker Compose / local PostgreSQL alternative (no SSL):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/civic_db

# Optional: force an SSL mode ("require", "verify-ca", "verify-full", ...).
# Usually unnecessary - it is inferred from the "sslmode" query parameter above.
# DB_SSL_MODE=require

# ── Application ───────────────────────────────────────────────────────────
DEBUG=true
